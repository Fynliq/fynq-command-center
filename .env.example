# Supabase production project. Server-side only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The one password for the dashboard login.
DASHBOARD_PASSWORD=

# A long random string (32+ characters) used to sign the login cookie.
# Generate one with: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=

# Comma-separated emails of founder/test accounts whose payments are not real revenue.
# Read on the server only; never sent to the browser.
EXCLUDED_BILLING_EMAILS=
